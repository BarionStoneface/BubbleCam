[Unit]
Description=BubbleCam aquarium recorder
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/BubbleCam
ExecStart=/home/pi/BubbleCam/.venv/bin/python -m bubblecam --config /home/pi/BubbleCam/config.yaml
Restart=always
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
